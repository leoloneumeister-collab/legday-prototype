# Copy to jarvis/.env and fill in. jarvis/.env is gitignored — keep it that way.

# --- Trading212 -------------------------------------------------------------
# Generate in the Trading212 app (Settings -> API). The key needs the
# "portfolio" and "account" scopes, or /equity/positions returns 403.
T212_API_KEY=
T212_API_SECRET=
# live = real money, demo = paper account. Start on demo if you want.
T212_ENV=live

# --- News (Finlight) --------------------------------------------------------
# NOTE: rotate the key that is currently hardcoded in the public aifa-news repo
# before reusing it here.
FINLIGHT_API_KEY=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides.
JARVIS_MODEL=claude-fable-5-1
JARVIS_EFFORT=medium

# --- Email delivery (Gmail: use an App Password, not your login password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=leoloneumeister@gmail.com
SMTP_PASS=
EMAIL_TO=leoloneumeister@gmail.com
EMAIL_FROM=

# --- Tuning -----------------------------------------------------------------
# Only report a position's move if it shifts value by at least this % ...
JARVIS_MOVE_PCT=2.0
# ... or this much in account currency, whichever triggers first.
JARVIS_MOVE_ABS=50
# How many news items reach the model after filtering.
JARVIS_NEWS_LIMIT=40
